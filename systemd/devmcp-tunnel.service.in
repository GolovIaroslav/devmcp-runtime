[Unit]
Description=DevMCP Runtime Secure MCP Tunnel
Requires=devmcp-runtime.service
After=devmcp-runtime.service

[Service]
Type=simple
ExecStartPre=/usr/bin/curl --fail --silent --show-error http://127.0.0.1:@MCP_PORT@/healthz
ExecStart=@TUNNEL_BIN@ runtimes connect --alias @ALIAS@ --tunnel-id @TUNNEL_ID@ --profile @PROFILE@ --mcp-server-url http://127.0.0.1:@MCP_PORT@/mcp --runtime-api-key file:@CONTROL_PLANE_KEY@
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target

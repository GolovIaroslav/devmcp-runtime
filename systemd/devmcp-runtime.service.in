[Unit]
Description=DevMCP Runtime MCP server

[Service]
Type=simple
WorkingDirectory=@RUNTIME_DIR@
Environment=DEVMCP_POLICY_CONFIG_FILE=@CONFIG_FILE@
ExecStart=@PYTHON@ -m coding_tools_mcp --workspace @WORKSPACE@ --host 127.0.0.1 --port @MCP_PORT@ --auth-token-file @MCP_TOKEN_FILE@ --policy-profile @POLICY_PROFILE@ --sandbox-backend @SANDBOX_BACKEND@
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
